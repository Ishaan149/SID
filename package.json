{
  "name": "aete-hdg-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "concurrently -k -n FIREBASE,VITE -c yellow,cyan \"npm run firebase:emulators\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "firebase:emulators": "firebase emulators:start --only firestore",
    "firebase:seed": "node scripts/seed-emulator.mjs",
    "firebase:reset": "firebase emulators:start --only firestore --export-on-exit=./.firebase-data --import=./.firebase-data",
    "test": "node --test"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.1.0",
    "firebase-tools": "^13.29.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
