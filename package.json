{
  "name": "aete-hdg-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "concurrently -k -n FIREBASE,VITE -c yellow,cyan \"npm run firebase:emulators\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "firebase:emulators": "firebase emulators:start --project demo-aete --only auth,firestore",
    "firebase:seed": "node scripts/seed-emulator.mjs",
    "firebase:reset": "firebase emulators:start --project demo-aete --only auth,firestore --export-on-exit=./.firebase-data --import=./.firebase-data",
    "test": "node --test",
    "test:rules": "firebase emulators:exec --project demo-aete --config firebase.test.json --only auth,firestore \"node --test test/auth-rules.test.mjs test/firebase-login.test.mjs test/tracker-rules.test.mjs test/firebase-data.test.mjs\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.1.0",
    "firebase-tools": "~13.35.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    },
    "firebase-tools": {
      "tar": "7.5.22",
      "universal-analytics": "0.5.3",
      "csv-parse": "7.0.3"
    },
    "get-uri": {
      "basic-ftp": "6.2.1"
    },
    "uuid": "11.1.1"
  }
}
